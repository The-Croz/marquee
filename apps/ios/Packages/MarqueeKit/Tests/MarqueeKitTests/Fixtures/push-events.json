{
  "events": [
    {
      "key": "request_pending",
      "group": "Requests",
      "audience": "admins",
      "label": "Someone asked for something",
      "description": "A request is waiting for you to approve or turn down.",
      "vars": [
        {
          "key": "user",
          "label": "Who asked",
          "example": "Jessie"
        },
        {
          "key": "title",
          "label": "Movie or show",
          "example": "Dune: Part Two"
        },
        {
          "key": "year",
          "label": "Year",
          "example": "2024"
        },
        {
          "key": "kind",
          "label": "Movie or show",
          "example": "movie"
        },
        {
          "key": "seasons",
          "label": "Seasons asked for",
          "example": "All"
        },
        {
          "key": "poster",
          "label": "Cover art address",
          "example": "https://image.tmdb.org/t/p/w500/8b8R8l88Qje9dn9OE8PY05Nxl1X.jpg"
        }
      ],
      "title": "New request",
      "body": "{{user}} asked for {{title}}{{#year}} ({{year}}){{/year}}.",
      "image": "{{poster}}",
      "priority": "normal"
    },
    {
      "key": "request_approved",
      "group": "Requests",
      "audience": "requester",
      "label": "Your request was approved",
      "description": "An admin said yes. Marquee is looking for it.",
      "vars": [
        {
          "key": "title",
          "label": "Movie or show",
          "example": "Dune: Part Two"
        },
        {
          "key": "year",
          "label": "Year",
          "example": "2024"
        },
        {
          "key": "by",
          "label": "Who approved it",
          "example": "Josh"
        },
        {
          "key": "poster",
          "label": "Cover art address",
          "example": "https://image.tmdb.org/t/p/w500/8b8R8l88Qje9dn9OE8PY05Nxl1X.jpg"
        }
      ],
      "title": "Request approved",
      "body": "{{title}} was approved. Marquee is looking for it.",
      "image": "{{poster}}",
      "priority": "normal"
    },
    {
      "key": "request_declined",
      "group": "Requests",
      "audience": "requester",
      "label": "Your request was turned down",
      "description": "An admin said no, and says why.",
