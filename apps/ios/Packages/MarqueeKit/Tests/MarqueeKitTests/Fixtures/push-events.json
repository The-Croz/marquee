        {
          "key": "problem",
          "label": "What’s wrong",
          "example": "Can’t reach qBittorrent"
        },
        {
          "key": "fix",
          "label": "What to do",
          "example": "Check it is running."
        }
      ],
      "title": "qBittorrent stopped working",
      "body": "{{problem}}.{{#fix}} {{fix}}{{/fix}}",
      "image": "",
      "priority": "normal"
    },
    {
      "key": "media_server_problem",
      "group": "Problems",
