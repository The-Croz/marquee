      "title": "Request turned down",
      "body": "{{title}} was turned down{{#reason}}: {{reason}}{{/reason}}{{^reason}}.{{/reason}}",
      "image": "{{poster}}",
      "priority": "normal"
    },
    {
      "key": "request_ready",
