      "body": "{{problem}}.{{#fix}} {{fix}}{{/fix}}",
      "image": "",
      "priority": "normal"
    },
    {
      "key": "downloader_problem",
      "group": "Problems",
      "audience": "admins",
      "label": "The downloader stopped working",
      "description": "Marquee can’t reach qBittorrent, it has no internet, or most downloads can’t find anyone to download from.",
