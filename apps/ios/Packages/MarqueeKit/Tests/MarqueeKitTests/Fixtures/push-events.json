        }
      ],
      "title": "{{server}} stopped answering",
      "body": "{{error}} Marquee tries again by itself.",
      "image": "",
      "priority": "normal"
    },
    {
      "key": "disk_low",
      "group": "Problems",
      "audience": "admins",
      "label": "A disk is nearly full",
      "description": "A downloads or library folder has less free than the minimum, so Marquee holds off on new downloads or copies.",
      "vars": [
        {
          "key": "folder",
          "label": "Which folder",
          "example": "Downloads"
        },
        {
          "key": "path",
          "label": "Where",
          "example": "/data/torrents"
        },
        {
          "key": "free",
          "label": "Free space",
          "example": "12.4 GB"
        },
        {
          "key": "minimum",
          "label": "Minimum kept free",
          "example": "20 GB"
        }
      ],
      "title": "{{folder}} disk is nearly full",
      "body": "{{free}} free on {{path}}; Marquee keeps {{minimum}} spare, so it’s waiting. Free up some space and it carries on by itself.",
